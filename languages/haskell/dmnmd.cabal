cabal-version:  2.4

-- This file is HAND-MAINTAINED and is the single source of truth for the build.
--
-- It used to be generated from package.yaml by hpack, and carried a banner saying
-- so. It no longer is: package.yaml, stack.yaml and stack.yaml.lock were removed
-- when dmnmd moved to cabal-only, to match legalese/l4-ide. Edit this file
-- directly. If you find a package.yaml, someone has reintroduced hpack and this
-- comment is stale.
--
-- One consequence to know about: hpack auto-discovered modules, and this file
-- does not. Adding a module under src/ means adding it to exposed-modules below,
-- or it silently will not be compiled into the library.

name:           dmnmd
version:        0.1.0.2
synopsis:       CLI to inter-convert DMN tables from Markdown format to JS, and more
description:    Decision Model & Notation format conversion and code generation. Please see the README on GitHub at <https://github.com/smucclaw/complaw/dmnmd>
category:       Code Generation
homepage:       https://github.com/smucclaw/dmnmd#readme
bug-reports:    https://github.com/smucclaw/dmnmd/issues
author:         Meng Weng Wong
maintainer:     mwwong@smu.edu.sg
copyright:      2022 Singapore Management University
license:        Apache-2.0
license-file:   LICENSE
build-type:     Simple
tested-with:    GHC == 9.10.3
extra-source-files:
    README.md
    ChangeLog.md

source-repository head
  type: git
  location: https://github.com/smucclaw/dmnmd

-- Only what all three components genuinely import. hpack expanded one
-- `dependencies:` block into every stanza, so until the cabal-only move each
-- component claimed the union of all three — the executable pulled in the whole
-- test framework, and the test suite pulled in hxt and (then still) regex-pcre.
-- The lists
-- below were derived from the actual import graph and are checked by the build.
common shared
  build-depends:
      base >=4.7 && <5
    -- >= 9.7.0 is load-bearing, not hygiene: DMN.Translate.L4 imports
    -- Text.Megaparsec.Unicode (isWideChar), which does not exist before it.
    -- The L4 ditto grid resolves `^` by absolute source column and must measure
    -- widths with the same table the L4 lexer uses.
    , megaparsec >=9.7.0
    , text
  default-language: Haskell2010
  -- A missing field in a record literal is a bottom waiting to be forced, never
  -- a style choice: GHC warns by default and then compiles it anyway. Adding a
  -- field to L4Opts turned two golden tests into a runtime RecConError that a
  -- build log full of other warnings had already scrolled past. Fatal here, so
  -- the compiler says it once, loudly, at the site.
  ghc-options:      -Werror=missing-fields

library
  import:          shared
  hs-source-dirs:  src
  build-depends:
      containers
    , hxt
    -- a more convenient Iso for the XML pickling
    , lens
    -- Control.Monad.Combinators.Expr
    , parser-combinators
    -- pretty-simple is deliberately absent, and the note that used to sit here
    -- was half right. No module imports it; its only uses in the tree are the
    -- two `-- $>` lines at src/DMN/XML/ParseDMN.hs:1124-1126, which
    -- `make ghcid` really does evaluate (ghcid --allow-eval). And that loop
    -- really does need the package: `cabal repl lib:dmnmd` hides every package
    -- this stanza does not name — ask that repl for
    -- `:m + System.Console.Haskeline` and it answers "hidden package" even
    -- though the executable in this same project depends on it — so with the
    -- dependency nowhere, the eval fails the same way.
    -- What the note got wrong is whose need it is. It is the ghcid command's,
    -- not the library's, so the Makefile's `ghcid` target passes
    -- `--build-depends pretty-simple` and every consumer of this library stops
    -- paying for a dev loop. If that eval starts reporting a hidden package,
    -- look there, not here.
    -- number parsing
    , scientific
    , split
  exposed-modules:
      DMN.DecisionTable
      DMN.Diagnostic
      DMN.Number
      DMN.ParseCell
      DMN.ParseFEEL
      DMN.ParseTable
      DMN.ParsingUtils
      DMN.SFeelGrammar
      DMN.Translate.FEELhelpers
      DMN.Translate.JS
      DMN.Translate.L4
      DMN.Translate.PY
      DMN.Translate.XML
      DMN.Types
      DMN.XML.ParseDMN
      DMN.XML.PickleHelpers
      DMN.XML.XmlToDmnmd
  ghc-options:
      -Wno-unused-matches
      -- A non-exhaustive case over FEELexp or DMNVal is a bomb with a delay
      -- fuse: it compiles, ships, and dies at run time on the one input that
      -- reaches the missing arm. feel2pyIn was ALREADY missing its FFunction
      -- arm while the JS twin had one. Not bare -Wall, which would bury this
      -- signal under unused-import noise.
      -Wincomplete-patterns
      -Werror=incomplete-patterns
      -- both consumed by stan, the static analyser
      -fwrite-ide-info
      -hiedir=.hie

executable dmnmd
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  other-modules:
      Options
      ParseMarkdown
  build-depends:
      dmnmd
    -- System.FilePath
    , filepath
    -- the -q eval REPL
    , haskeline
    , optparse-applicative
    -- Data.List.Split
    , split
  ghc-options:     -threaded -rtsopts -with-rtsopts=-N

test-suite dmnmd-test
  import:          shared
  type:            exitcode-stdio-1.0
  hs-source-dirs:  test
  main-is:         Spec.hs
  other-modules:
      DmnXmlSpec
      ParseFEELSpec
      ParserSpecHelpers
      SFeelGrammar
      TranslateL4Spec
  build-depends:
      dmnmd
    -- TranslateL4Spec: createDirectoryIfMissing for test/golden/.out
    , directory
    , hspec
    , hspec-golden
    , hspec-megaparsec
    -- TranslateL4Spec: readProcessWithExitCode, to shell out to the l4 binary
    , process
    , raw-strings-qq
  ghc-options:     -threaded -rtsopts -with-rtsopts=-N
