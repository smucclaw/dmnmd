<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="drgall" name="Every DRG Construct"
             namespace="https://example.org/dmnmd/test/drgall">
  <import id="Import_1" name="other" namespace="https://example.org/other"
          importType="https://www.omg.org/spec/DMN/20191111/MODEL/"/>
  <inputData id="InputData_age" name="Age"/>
  <knowledgeSource id="KS_1" name="Bylaws"/>
  <decision id="Decision_band" name="Band">
    <informationRequirement id="IR_age">
      <requiredInput href="#InputData_age"/>
    </informationRequirement>
    <knowledgeRequirement id="KR_1">
      <requiredKnowledge href="#BKM_1"/>
    </knowledgeRequirement>
    <authorityRequirement id="AR_1">
      <requiredAuthority href="#KS_1"/>
    </authorityRequirement>
    <decisionTable id="DecisionTable_band" hitPolicy="FIRST">
      <input id="Input_age">
        <inputExpression id="InputExpression_age" typeRef="number">
          <text>age</text>
        </inputExpression>
      </input>
      <output id="Output_band" name="Band" label="Band" typeRef="string"/>
      <rule id="Rule_b1">
        <inputEntry id="UT_b1"><text>&lt; 18</text></inputEntry>
        <outputEntry id="LE_b1"><text>"minor"</text></outputEntry>
      </rule>
      <rule id="Rule_b2">
        <inputEntry id="UT_b2"><text>&gt;= 18</text></inputEntry>
        <outputEntry id="LE_b2"><text>"adult"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <textAnnotation id="TA_1">
    <text>Bands are set by the 2019 bylaws.</text>
  </textAnnotation>
  <association id="Assoc_1" sourceRef="#Decision_band" targetRef="#TA_1"/>
</definitions>
