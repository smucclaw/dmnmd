DECLARE WHERE HAS
    Dish IS A STRING
    Fee  IS A NUMBER

GIVEN v1 IS A STRING
      v2 IS A NUMBER
GIVETH A WHERE
mkWHERE v1 v2 MEANS WHERE WITH
    Dish IS v1
    Fee  IS v2

GIVEN Guests IS A NUMBER
GIVETH A WHERE
`WHERE` Guests MEANS
  BRANCH
    IF Guests <= 8 THEN mkWHERE "Spareribs" 10
    OTHERWISE mkWHERE "Stew" 20

