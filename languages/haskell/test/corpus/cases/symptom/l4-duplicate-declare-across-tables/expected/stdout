DECLARE Category
  IS ONE OF
    `Dining`
    `Grocery`

GIVEN merchant IS A STRING
GIVETH A MAYBE Category
Categorize merchant MEANS
  BRANCH
    IF merchant EQUALS "foodpanda" THEN JUST `Dining`
    IF ^        ^      "nfmart"    THEN JUST `Grocery`
    OTHERWISE NOTHING

DECLARE Category
  IS ONE OF
