export function GuestCount ( Season : string, Guest_Count ) {
  if (Season === "Fall" && Guest_Count === "<= 8") { // 1
    return {"Dish":"Spareribs"};
  }
  else if (Season === "Winter" && Guest_Count === "> 8") { // 2
    return {"Dish":"Stew"};
  }
  else if (Season === "Spring" && Guest_Count === "unknown") { // 3
    return {"Dish":"Takeaway"};
  }
}

