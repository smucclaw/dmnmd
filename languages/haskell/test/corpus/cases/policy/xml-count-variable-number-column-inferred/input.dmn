<?xml version="1.0" encoding="UTF-8"?>
<!-- A single-output COLLECT COUNT table whose decision <variable> says
     typeRef="number" while its output column holds STRINGS.

     That is correct DMN, not a contradiction. DMN 1.3 section 8.2.10: under
     "# (count): the result of the decision table is the number of outputs",
     and section 6.3.7 makes the decision's variable "the instance of
     InformationItem that stores the result of this Decision". So under C# the
     variable types the COUNT, and says nothing about the column, whose cells
     are counted rather than returned. The <output> clause carries no typeRef,
     as section 8.3.2 requires of a single-output table, so the column's type
     is inferred from its cells: "vip" and "member" are string literals.

     A reader that applies the variable to the column reads those cells as
     numbers and refuses a valid document, cell by cell, at exit 1. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="countVariableNumber" name="Count Variable Number"
             namespace="https://example.org/dmnmd/test/countVariableNumber">
  <decision id="Decision_howMany" name="HowMany">
    <variable id="Variable_howMany" name="HowMany" typeRef="number"/>
    <decisionTable id="DecisionTable_howMany" hitPolicy="COLLECT" aggregation="COUNT"
                   outputLabel="flag">
      <input id="Input_tier" label="tier">
        <inputExpression id="InputExpression_tier" typeRef="string">
          <text>tier</text>
        </inputExpression>
      </input>
      <output id="Output_flag"/>
      <rule id="Rule_1">
        <inputEntry id="UnaryTests_1"><text>"gold"</text></inputEntry>
        <outputEntry id="LiteralExpression_1"><text>"vip"</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="UnaryTests_2"><text>"silver"</text></inputEntry>
        <outputEntry id="LiteralExpression_2"><text>"member"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
