<?xml version="1.0" encoding="UTF-8"?>
<!-- The negative control for decision-table-typeref.dmn: a decisionTable typeRef is
     NOT applied to the columns of a MULTI-output table.

     DMN puts a column's type on its own <output> clause when the table has more
     than one output (DMN 1.3 section 8.3.2, Table 34: the clause of a
     multi-output table MAY specify a typeRef). The table-level typeRef then names
     the type of the whole result, a composite whose type is an <itemDefinition>,
     not the type of any one column. Applying it here would give both columns the
     composite's type: both "rank" and "name" would become the text "7" and "silver".

     So "rank", which declares no typeRef of its own, must still be INFERRED, and
     its bare numerals make it a Number: the ts output has 7.0, unquoted. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="decisionTableTypeRefMulti" name="Decision Table TypeRef Multi"
             namespace="https://example.org/dmnmd/test/decisionTableTypeRefMulti">
  <decision id="Decision_band" name="Band">
    <variable id="Variable_band" name="Band"/>
    <decisionTable id="DecisionTable_band" hitPolicy="FIRST" typeRef="string">
      <input id="Input_tier" label="tier">
        <inputExpression id="InputExpression_tier" typeRef="string">
          <text>tier</text>
        </inputExpression>
      </input>
      <output id="Output_rank" name="rank"/>
      <output id="Output_name" name="name" typeRef="string"/>
      <rule id="Rule_1">
        <inputEntry id="UnaryTests_1"><text>"gold"</text></inputEntry>
        <outputEntry id="LiteralExpression_1a"><text>7</text></outputEntry>
        <outputEntry id="LiteralExpression_1b"><text>"silver"</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="UnaryTests_2"><text>"silver"</text></inputEntry>
        <outputEntry id="LiteralExpression_2a"><text>8</text></outputEntry>
        <outputEntry id="LiteralExpression_2b"><text>"bronze"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
