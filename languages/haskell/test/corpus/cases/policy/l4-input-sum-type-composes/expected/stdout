DECLARE Category
  IS ONE OF
    `Dining`
    `Grocery`

DECLARE Card
  IS ONE OF
    `PRVI`
    `Amex`

GIVEN merchant IS A STRING
GIVETH A Category
Categorize merchant MEANS
  BRANCH
    IF merchant EQUALS "foodpanda" THEN `Dining`
    IF ^        ^      "nfmart"    THEN `Grocery`
    OTHERWISE `Grocery`

GIVEN category IS A Category
GIVETH A Card
CardToUse category MEANS
  BRANCH
    IF category EQUALS `Dining` THEN `PRVI`
    OTHERWISE `Amex`

