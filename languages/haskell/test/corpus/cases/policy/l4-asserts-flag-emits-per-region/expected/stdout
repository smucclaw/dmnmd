DECLARE Eligible HAS
    label    IS A STRING
    discount IS A NUMBER

GIVEN v1 IS A STRING
      v2 IS A NUMBER
GIVETH A Eligible
mkEligible v1 v2 MEANS Eligible WITH
    label    IS v1
    discount IS v2

GIVEN age    IS A NUMBER
      member IS A BOOLEAN
GIVETH A MAYBE Eligible
Eligible age member MEANS
  BRANCH
    IF age <  18 AND member EQUALS TRUE THEN JUST (mkEligible ("minor member") -5)
    IF ^   >= 65 ^   ^      ^      ^    THEN JUST (mkEligible ("senior member") 20)
    OTHERWISE NOTHING

-- emitAsserts: table "Eligible": 6 regions, 6 asserted.
#ASSERT Eligible 17 TRUE EQUALS JUST (mkEligible "minor member" (-5))
#ASSERT Eligible 17 FALSE EQUALS NOTHING
#ASSERT Eligible 18 TRUE EQUALS NOTHING
#ASSERT Eligible 18 FALSE EQUALS NOTHING
#ASSERT Eligible 65 TRUE EQUALS JUST (mkEligible "senior member" 20)
#ASSERT Eligible 65 FALSE EQUALS NOTHING

