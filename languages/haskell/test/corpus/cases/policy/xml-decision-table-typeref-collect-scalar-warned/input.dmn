<?xml version="1.0" encoding="UTF-8"?>
<!-- The negative control for decision-table-typeref-collect-is-list.dmn: a COLLECT
     table whose <decisionTable> typeRef names a SINGLE value.

     Under a list-valued hit policy the decision's result is a list, so a scalar
     typeRef contradicts the hit policy. dmnmd does not pick a reading: it does not
     apply the type to the output column, infers the column from its cells, and
     WARNS that it did so (the same treatment collect-variable-scalar-warned.dmn
     gives the decision's <variable>). The cells are strings, so applying "number"
     would have refused them; not applying it keeps this table.

     Before the table's typeRef was read at all, it was ignored with no diagnostic. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="dtCollectScalar" name="DT Collect Scalar"
             namespace="https://example.org/dmnmd/test/dtCollectScalar">
  <decision id="Decision_bands" name="Bands">
    <variable id="Variable_bands" name="Bands"/>
    <decisionTable id="DecisionTable_bands" hitPolicy="COLLECT" typeRef="number">
      <input id="Input_age" label="age">
        <inputExpression id="InputExpression_age" typeRef="number"><text>age</text></inputExpression>
      </input>
      <output id="Output_band"/>
      <rule id="Rule_1">
        <inputEntry id="UnaryTests_1"><text>&lt; 18</text></inputEntry>
        <outputEntry id="LiteralExpression_1"><text>"gold"</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="UnaryTests_2"><text>&lt; 21</text></inputEntry>
        <outputEntry id="LiteralExpression_2"><text>"silver"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
