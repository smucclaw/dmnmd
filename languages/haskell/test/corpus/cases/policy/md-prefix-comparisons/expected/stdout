export function PrefixComparisons ( Age : number, Scheme : string ) {
  if (Age < 18.0 && Scheme === "child") { // 1
    return {"Band":"minor"};
  }
  else if (Age >= 18.0 && Scheme === "child") { // 2
    return {"Band":"adult"};
  }
  else if (Age <= 21.0 && Scheme === "youth") { // 3
    return {"Band":"young"};
  }
  else if (Age > 21.0 && Scheme === "youth") { // 4
    return {"Band":"adult"};
  }
}

