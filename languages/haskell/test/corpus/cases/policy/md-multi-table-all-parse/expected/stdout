export function Dish ( Season : string ) {
  if (Season === "Fall") { // 1
    return {"Dish":"Stew"};
  }
  else if (Season === "Winter") { // 2
    return {"Dish":"Roast"};
  }
}

export function Drink ( Season : string ) {
  if (Season === "Fall") { // 1
    return {"Drink":"Cider"};
  }
  else if (Season === "Winter") { // 2
    return {"Drink":"Mulled Wine"};
  }
}

export function Dessert ( Season : string ) {
  if (Season === "Fall") { // 1
    return {"Dessert":"Pie"};
  }
}

