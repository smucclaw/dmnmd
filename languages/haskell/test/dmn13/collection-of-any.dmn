<?xml version="1.0" encoding="UTF-8"?>
<!-- An <itemDefinition isCollection="true"> whose element type is Any.

     This is the interaction between two separately-reasonable rules, and it bit.
     resolveTypeRef wraps a collection's element type with `DMN_List <$> ty`, which
     is safe only while every Nothing carries a diagnostic. Reading typeRef="Any"
     as "no restriction, infer" introduced the first diagnostic-free Nothing, and
     fmap over Nothing silently drops the DMN_List: the column stopped being a
     collection, with no warning, at exit 0. A cell that means MEMBERSHIP was then
     emitted as EQUALITY — `roles === "admin"` against an array, false for every
     input, so every rule in the column became unreachable.

     dmnmd cannot infer an element type for a collection: inference runs per
     column and produces scalars, and guessing wrong turns membership into a test
     that can never match. So this is refused, which is what the same reasoning
     already does for any other unmodellable column type. Refusing here also
     restores what trunk did before Any was recognised at all, so nothing that
     worked is lost — only the silent wrong answer is. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="acc" name="Acc" namespace="https://example.org/dmnmd/test/acc">
  <itemDefinition name="tRoles" isCollection="true"><typeRef>Any</typeRef></itemDefinition>
  <inputData id="InputData_roles" name="Roles"/>
  <decision id="Decision_access" name="Access">
    <decisionTable id="DT_access" hitPolicy="FIRST">
      <input id="I_roles" label="roles">
        <inputExpression id="IE_roles" typeRef="tRoles"><text>roles</text></inputExpression>
      </input>
      <output id="O_grant" name="Grant" label="Grant" typeRef="string"/>
      <rule id="R1">
        <inputEntry id="U1"><text>"admin"</text></inputEntry>
        <outputEntry id="L1"><text>"full"</text></outputEntry>
      </rule>
      <rule id="R2">
        <inputEntry id="U2"><text>"clerk", "teller"</text></inputEntry>
        <outputEntry id="L2"><text>"read"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
