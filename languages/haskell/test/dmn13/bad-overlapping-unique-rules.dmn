<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="ageBand" name="Age Band"
             namespace="https://example.org/dmnmd/test/ageBand">
  <decision id="Decision_band" name="Band">
    <!-- No hitPolicy attribute, as in bad-duplicate-unique-rules.dmn: the XSD
         and ParseDMN both default it to UNIQUE. The two rules are not
         identical, so D-13 has nothing to say; they overlap on [10..20], which
         D-22 rule 2 refuses. -->
    <decisionTable id="DecisionTable_band">
      <input id="Input_age" label="Age">
        <inputExpression id="InputExpression_age" typeRef="number">
          <text>age</text>
        </inputExpression>
      </input>
      <output id="Output_fee" name="fee" label="Fee" typeRef="number"/>
      <rule id="Rule_1">
        <inputEntry id="UnaryTests_1"><text>&lt;= 20</text></inputEntry>
        <outputEntry id="LiteralExpression_1"><text>5</text></outputEntry>
      </rule>
      <rule id="Rule_2">
        <inputEntry id="UnaryTests_2"><text>&gt;= 10</text></inputEntry>
        <outputEntry id="LiteralExpression_2"><text>10</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
